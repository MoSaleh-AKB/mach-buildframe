    for f in ("slots", "doctors", "protocol", "rules"):
        p.add_argument("--" + f, action="store_true")
    add("profile", simple_tab("profile"), "members, quotas, facilities, egress")
    add("team", simple_tab("team"), "team header")
    add("leaderboard", simple_tab("leaderboard"), "public leaderboard")
    add("agents", simple_tab("agents"), "/v1/agents list (visibility, version)")
    p = add("agent", cmd_agent, "one agent: overview, logs, messages")
    p.add_argument("role", metavar="ROLE", help="gp, booking_centre, hospital, specialist, family_counseling")
    p.add_argument("what", nargs="?", default="overview", choices=["overview", "logs", "messages"])
    p.add_argument("--q", default="")
    p.add_argument("--errors", action="store_true")
    p.add_argument("--no-health", action="store_true", dest="no_health")
    p.add_argument("--tail", type=int, default=40)
    p = add("journeys", cmd_journeys, "list journeys")
    p.add_argument("--state")
    p.add_argument("--limit", type=int, default=0)
    p.add_argument("--detail", action="store_true", help="fetch each journey (message count, last sender, verdict)")
    p = add("journey", cmd_journey, "full trace of one journey")
    p.add_argument("need_id")
    add("citizens", cmd_citizens, "first message of every journey grouped by symptom family")
    add("unanswered", cmd_unanswered, "open journeys whose last message is the citizen's, oldest first")
    add("inflight", cmd_inflight, "deployments in flight and the 300 s per-agent quota countdown")
    p = add("watch", cmd_watch, "print only changes, every N seconds")
    p.add_argument("--every", type=int, default=60)
    p = add("tail", cmd_tail, "follow new non-health log lines of one agent")
    p.add_argument("role")
    p.add_argument("--every", type=int, default=20)
    p = add("dump", cmd_dump, "save every tab's raw JSON into DIR")
    p.add_argument("dir")
    add("gate", cmd_gate, "local pre-deploy gate (no network)")
    p = add("get", cmd_get, "raw GET of one /v1 path (debug)")
    p.add_argument("path")
    a = ap.parse_args()
    try:
        a.fn(a)
    except FetchError as exc:
        print(f"mach: {exc}", file=sys.stderr)
        return 3
    except KeyboardInterrupt:
        return 130
