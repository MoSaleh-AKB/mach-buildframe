#!/usr/bin/env python3
"""mach: read-only CLI for the MACH team console. See README.md.

GET only, never /v1/admin/*. Calls go through `edge fetch` (hidden headless Edge with the
team login), spaced 2 s apart, cached 30 s on disk, retried after 20-40 s on HTTP 429.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote
from zoneinfo import ZoneInfo

BASE = "https://projectnandaitaly.ai"
HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent
CACHE = HERE / "out" / "cache"
STATE = HERE / "out" / "state.json"
ROME = ZoneInfo("Europe/Rome")
CACHE_TTL = int(os.environ.get("MACH_CACHE_TTL", "30"))  # seconds; env override only for batch runs
MIN_GAP = 2.0
QUOTA_SECONDS = 300
ROLES = ["gp", "booking_centre", "hospital", "specialist", "family_counseling"]
FAMILY = {"specialist": "specialist_care"}
PENALTY_ROLES = {"gp", "booking_centre", "family_counseling"}
TABS = {"team": "/v1/team", "assignment": "/v1/team/assignment", "deployments": "/v1/team/deployments",
        "wave": "/v1/team/wave", "reputation": "/v1/team/reputation", "usage": "/v1/team/usage",
        "market": "/v1/team/market", "conversations": "/v1/team/conversations",
        "world": "/v1/team/world", "journeys": "/v1/team/journeys", "profile": "/v1/team/profile",
        "agents": "/v1/agents", "leaderboard": "/v1/leaderboard"}


# ---------------------------------------------------------------- fetch

class FetchError(Exception):
    pass


def _gap() -> None:
    f = CACHE / ".last"
    try:
        last = float(f.read_text())
    except (OSError, ValueError):
        last = 0.0
    wait = last + MIN_GAP - time.time()
    if wait > 0:
        time.sleep(wait)


def _stamp() -> None:
    try:
        (CACHE / ".last").write_text(str(time.time()))
    except OSError:
        pass


def fetch(path: str, ttl: int = CACHE_TTL, raw: bool = False) -> object:
    """GET one console path. Returns parsed JSON. Raises FetchError."""
    if not path.startswith("/v1/") or path.startswith("/v1/admin"):
        raise FetchError("refused: only GET on /v1/* (never /v1/admin/*)")
    CACHE.mkdir(parents=True, exist_ok=True)
    key = CACHE / (hashlib.sha1(path.encode()).hexdigest() + ".json")
    if key.exists() and time.time() - key.stat().st_mtime < ttl:
        try:
            cached = json.loads(key.read_text())
            if not raw or isinstance(cached, str):
                return cached
        except ValueError:
            pass
    last = ""
    tries = 0
    while tries < 4:
        tries += 1
        _gap()
        try:
            res = subprocess.run(["edge", "fetch", BASE + path], capture_output=True, text=True, timeout=90)
        except (OSError, subprocess.TimeoutExpired) as exc:
            _stamp()
            raise FetchError(f"edge failed: {exc}")
        _stamp()
        text = res.stdout.strip()
        err = (res.stderr or "").strip()
        if text.startswith("<!doctype") or "429" in err:
            last = "HTTP 429 rate limited"
            wait = 20 + 7 * tries
            print(f"  (429, waiting {wait}s)", file=sys.stderr)
            time.sleep(wait)
            continue
        if res.returncode != 0 and not text:
            last = err[:160] or f"exit {res.returncode}"
            if "503" in err or "502" in err or "504" in err:
                time.sleep(5)
                continue
            raise FetchError(last)
        if raw:
            key.write_text(json.dumps(text))
            return text
        try:
            data = json.loads(text)
        except ValueError:
            raise FetchError("not json: " + text[:120])
        key.write_text(text)
        return data
    raise FetchError(last or "failed")


def get(path: str, default=None):
    try:
        return fetch(path)
    except FetchError as exc:
        print(f"  [warn] {path}: {exc}", file=sys.stderr)
        return default


# ---------------------------------------------------------------- helpers

def now() -> datetime:
    return datetime.now(timezone.utc)


def parse_t(s) -> datetime | None:
    if not s or not isinstance(s, str):
        return None
    try:
        s = s.replace("Z", "+00:00")
        m = re.match(r"(.*\.\d{6})\d*(\+.*)?$", s)
        if m:
            s = m.group(1) + (m.group(2) or "")
        d = datetime.fromisoformat(s)
        return d if d.tzinfo else d.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def rome(s, date=False) -> str:
    d = s if isinstance(s, datetime) else parse_t(s)
    if not d:
        return "-"
    d = d.astimezone(ROME)
    return d.strftime("%d %H:%M:%S") if date else d.strftime("%H:%M:%S")


def ago(secs: float | None) -> str:
    if secs is None:
        return "-"
    secs = int(secs)
    if secs < 120:
        return f"{secs}s"
    if secs < 7200:
        return f"{secs // 60}m{secs % 60:02d}s"
    return f"{secs // 3600}h{(secs % 3600) // 60:02d}m"


def trunc(s, n) -> str:
    s = str(s if s is not None else "").replace("\n", " / ")
    return s if len(s) <= n else s[: n - 1] + "~"


def table(rows: list[list], head: list[str]) -> str:
    rows = [[str(c) for c in r] for r in rows]
    w = [max(len(head[i]), *(len(r[i]) for r in rows)) if rows else len(head[i]) for i in range(len(head))]
    out = ["  ".join(head[i].ljust(w[i]) for i in range(len(head))).rstrip()]
    out.append("  ".join("-" * w[i] for i in range(len(head))))
    for r in rows:
        out.append("  ".join(r[i].ljust(w[i]) for i in range(len(head))).rstrip())
    return "\n".join(out)


def emit_json(obj) -> None:
    print(json.dumps(obj, indent=1, ensure_ascii=False, default=str))


def citizen_no(cid) -> str:
    m = re.search(r"(\d+)$", str(cid or ""))
    return m.group(1).lstrip("0") or "0" if m else str(cid)


def text_of(m: dict) -> str:
    b = m.get("body")
    if isinstance(b, dict):
        return str(b.get("text") if b.get("text") is not None else json.dumps(b, ensure_ascii=False))
    return str(b if b is not None else "")


def rows_of(data, *keys):
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for k in keys:
            if isinstance(data.get(k), list):
                return data[k]
    return []


# ---------------------------------------------------------------- model

def brain_folders() -> dict[str, list[str]]:
    out: dict[str, list[str]] = {}
    for d in sorted((REPO / "asst").glob("*")):
        for fn in ("card.yaml", "city.yaml"):
            f = d / fn
            if f.is_file():
                for line in f.read_text(errors="replace").splitlines():
                    m = re.match(r"\s*agent_id:\s*(agent:[a-z0-9]+)", line)
                    if m and d.name not in out.setdefault(m.group(1), []):
                        out[m.group(1)].append(d.name)
    return out


class World:
    """Everything read from the console once per command (cached on disk)."""

    def __init__(self):
        self.assignment = get("/v1/team/assignment", {}) or {}
        self.deps_raw = get("/v1/team/deployments", {}) or {}
        self.brains = brain_folders()
        self._journeys = None
        self._details: dict[str, dict] = {}
        self._logs: dict[tuple, list] = {}
        self.roster = self._roster()
        self.deployments = rows_of(self.deps_raw, "deployments")
        self.agent_role: dict[str, str] = {}
        for role, r in self.roster.items():
            for a in r["agents"]:
                self.agent_role.setdefault(a["agent_id"], role)
            if r["confirmed"]:
                self.agent_role[r["confirmed"]] = role
        for d in self.deployments:
            aid = d.get("agent_id")
            if aid and aid not in self.agent_role:
                folders = [f for f in self.brains.get(aid, []) if not f.endswith("_kit")]
                self.agent_role[aid] = (folders[0] if folders else "?")
        self.state = self._load_state()
        self._note_deployments()

    # roster
    def _roster(self) -> dict:
        roster: dict[str, dict] = {}
        for r in rows_of(self.assignment, "roles") if isinstance(self.assignment, dict) else []:
            fam = r.get("family")
            agents = [a for a in r.get("agents", []) if isinstance(a, dict) and a.get("agent_id")]
            roster[fam] = {"family": fam, "confirmed": r.get("confirmed_agent"), "agents": agents,
                           "summary": r.get("summary")}
        return roster

    def role_key(self, role: str) -> str:
        """Roster family name for a CLI role."""
        for cand in (role, FAMILY.get(role, ""), role + "_care"):
            if cand and cand in self.roster:
                return cand
        return FAMILY.get(role, role)

    def display_role(self, family: str) -> str:
        return {"specialist_care": "specialist"}.get(family, family)

    def agent_of(self, role: str) -> str | None:
        fam = self.role_key(role)
        r = self.roster.get(fam)
        if r and r["confirmed"]:
            return r["confirmed"]
        if r and r["agents"]:
            return r["agents"][0]["agent_id"]
        for aid, rl in self.agent_role.items():
            if self.display_role(rl) == role or rl == role:
                return aid
        return None

    def role_name(self, aid: str) -> str:
        if not aid:
            return "-"
        if aid.startswith("citizen:"):
            return "citizen " + citizen_no(aid)
        rl = self.agent_role.get(aid)
        return self.display_role(rl) if rl else aid.replace("agent:", "")[:8]

    def agents_list(self) -> dict:
        if not hasattr(self, "_agents"):
            self._agents = {x.get("agent_id"): x for x in rows_of(get("/v1/agents", []), "agents")}
        return self._agents

    def visibility(self, aid: str) -> str:
        for r in self.roster.values():
            for a in r["agents"]:
                if a["agent_id"] == aid:
                    return str(a.get("visibility") or "?")
        x = self.agents_list().get(aid)
        if x:
            return str(x.get("visibility") or "?") + " (/v1/agents)"
        return "not in roster"

    def all_agents(self) -> list[str]:
        ids: list[str] = []
        for role in ROLES:
            a = self.agent_of(role)
            if a and a not in ids:
                ids.append(a)
        for r in self.roster.values():
            for a in r["agents"]:
                if a["agent_id"] not in ids:
                    ids.append(a["agent_id"])
        for d in self.deployments:
            if d.get("agent_id") and d["agent_id"] not in ids:
                ids.append(d["agent_id"])
        return ids

    # deployments
    def _load_state(self) -> dict:
        try:
            return json.loads(STATE.read_text())
        except (OSError, ValueError):
            return {}

    def _note_deployments(self) -> None:
        seen = self.state.setdefault("dep_first_seen", {})
        changed = False
        for d in self.deployments:
            i = d.get("deployment_id")
            if i and i not in seen:
                seen[i] = now().isoformat()
                changed = True
        if changed:
            try:
                STATE.parent.mkdir(parents=True, exist_ok=True)
                STATE.write_text(json.dumps(self.state))
            except OSError:
                pass

    def newest_dep(self, aid: str) -> dict | None:
        mine = [d for d in self.deployments if d.get("agent_id") == aid]
        if not mine:
            return None

        def stamp(d):
            t = self.dep_time(d)
            return (t.timestamp() if t else 0.0)
        # explicit timestamps win; otherwise the later list entry is the newer one
        if any(self.dep_time(d, real_only=True) for d in mine):
            return max(mine, key=stamp)
        return mine[-1]

    def dep_time(self, d: dict, real_only=False) -> datetime | None:
        for k in ("created_at", "updated_at", "created", "started_at", "submitted_at", "time"):
            t = parse_t(d.get(k))
            if t:
                return t
        if real_only:
            return None
        t = parse_t((self.state.get("dep_first_seen") or {}).get(d.get("deployment_id")))
        return t

    def dep_age(self, aid: str) -> tuple[float | None, str]:
        """Seconds since the agent's last deployment was created (most recent evidence)."""
        cands: list[tuple[float, str]] = []
        d = self.newest_dep(aid)
        if d:
            t = self.dep_time(d)
            if t:
                src = "console" if self.dep_time(d, real_only=True) else "first seen by mach"
                cands.append((now().timestamp() - t.timestamp(), src))
        folders = [f for f in self.brains.get(aid, []) if not f.endswith("_kit")]
        logs = REPO / "deploy-logs"
        if logs.is_dir():
            for f in logs.glob("*.log"):
                if any(fo in f.name for fo in folders):
                    cands.append((time.time() - f.stat().st_mtime, "deploy log " + f.name))
        if not cands:
            return None, "unknown"
        best = min(cands)
        return best

    @staticmethod
    def dep_failed(d: dict) -> list[dict]:
        return [c for c in d.get("conformance") or [] if str(c.get("outcome")).upper() == "FAIL"]

    @staticmethod
    def dep_state(d: dict | None) -> str:
        """LIVE / FAILED / IN FLIGHT. A conformance FAIL kept on a deployment that is back in
        rollout is an old result: the deployment counts as IN FLIGHT."""
        if not d:
            return "NONE"
        status = str(d.get("status") or "").lower()
        step = str(d.get("step") or "").lower()
        txt = " ".join(str(d.get(k) or "") for k in ("detail", "error", "message")).lower()
        if status in ("promoted", "live", "active", "running", "ready", "done", "succeeded", "deployed", "serving"):
            return "LIVE"
        if any(w in status for w in ("fail", "error", "reject")) or "quota_exceeded" in txt or "did not become ready" in txt:
            return "FAILED"
        if step == "rollout":
            return "IN FLIGHT"
        if World.dep_failed(d):
            return "FAILED"
        return "IN FLIGHT"

    # journeys
    def journeys(self) -> list[dict]:
        if self._journeys is None:
            self._journeys = rows_of(get("/v1/team/journeys", {}), "journeys")
        return self._journeys

    def detail(self, need_id: str) -> dict:
        if need_id not in self._details:
            d = get(f"/v1/team/journeys/{need_id}", {})
            self._details[need_id] = d if isinstance(d, dict) else {}
        return self._details[need_id]

    def details(self, state: str | None = None) -> list[dict]:
        out = []
        for j in self.journeys():
            if state and str(j.get("state")) != state:
                continue
            d = self.detail(j["need_id"])
            d = dict(d)
            d.setdefault("journey", j)
            out.append(d)
        return out

    # logs
    def logs(self, aid: str, q: str = "") -> list[dict] | None:
        k = (aid, q)
        if k not in self._logs:
            try:
                data = fetch(f"/v1/logs?agent_id={quote(aid, safe=':')}&q={quote(q)}")
            except FetchError as exc:
                print(f"  [warn] logs {aid} q={q!r}: {exc}", file=sys.stderr)
                self._logs[k] = None
                return None
            rows = rows_of(data, "lines", "logs", "items")
            self._logs[k] = sorted(rows, key=lambda r: str(r.get("time", "")))
        return self._logs[k]

    def container(self, aid: str, counts: bool = True) -> dict:
        rows = self.logs(aid)
        info = {"agent_id": aid, "state": "UNKNOWN", "last": None, "age": None, "deliveries": None,
                "brain_runs": None, "say_failed": None, "say_lines": []}
        if rows is None:
            return info
        if not rows:
            return info
        last = rows[-1]
        t = parse_t(last.get("time"))
        info["last"] = last.get("time")
        info["age"] = (now() - t).total_seconds() if t else None
        msg = str(last.get("message", ""))
        down_msg = ("Finished server process" in msg or "Application shutdown complete" in msg
                    or "Shutting down" in msg or "Waiting for application shutdown" in msg)
        if down_msg:
            info["state"] = "SHUT DOWN"
        elif info["age"] is not None and info["age"] > 60:
            info["state"] = "STALE"
        else:
            info["state"] = "UP"
        if counts and info["state"] == "UP":
            dl = self.logs(aid, "delivery")
            br = self.logs(aid, "brain done")
            sf = self.logs(aid, "care.say.failed")
            info["deliveries"] = None if dl is None else len(dl)
            info["brain_runs"] = None if br is None else len(br)
            info["say_failed"] = None if sf is None else len(sf)
            info["say_lines"] = [str(r.get("message", "")) for r in (sf or [])][-3:]
        return info

    def replies(self, aid: str) -> dict:
        """Messages FROM this agent seen in the journeys (the only proof of life that never 429s)."""
        times = []
        for d in self.details():
            for m in d.get("messages", []):
                if m.get("from") == aid:
                    t = parse_t(m.get("sent_at"))
                    if t:
                        times.append(t)
        times.sort()
        n = now()
        return {"last": times[-1].isoformat() if times else None,
                "age": (n - times[-1]).total_seconds() if times else None,
                "n10": sum(1 for t in times if (n - t).total_seconds() <= 600),
                "n15": sum(1 for t in times if (n - t).total_seconds() <= 900),
                "total": len(times)}

    def serving(self, aid: str, con: dict) -> dict:
        """UP when the newest deployment is promoted AND (recent log lines OR a reply in the last 10 min).
        Empty or failed logs are UNKNOWN, never a fault."""
        dep = self.newest_dep(aid)
        ds = self.dep_state(dep)
        rep = self.replies(aid)
        if ds == "IN FLIGHT":
            state, why = "IN FLIGHT", "deployment in rollout/conformance"
        elif ds == "FAILED":
            state, why = "NOT DEPLOYED", "newest deployment failed"
        elif ds == "NONE":
            state, why = "NOT DEPLOYED", "no deployment"
        elif rep["n10"] > 0:
            state, why = "UP", f"{rep['n10']} replies in the last 10 min"
        elif con["state"] == "UP":
            state, why = "UP", "recent log lines"
        elif con["state"] in ("SHUT DOWN", "STALE"):
            state, why = "LOGS SAY DOWN", f"last log {con['state']} {ago(con['age'])} ago, no reply in 10 min"
        else:
            state, why = "UNKNOWN", "promoted, logs empty or rate limited, no recent reply (not proof of a fault)"
        return {"state": state, "why": why, "deployment_state": ds, "deployment_status": (dep or {}).get("status"),
                "last_reply": rep["last"], "last_reply_age": rep["age"], "replies_10m": rep["n10"],
                "replies_15m": rep["n15"], "replies_total": rep["total"]}


# ---------------------------------------------------------------- doctor logic

def agent_open_journeys(w: World, aid: str) -> list[dict]:
    out = []
    for d in w.details("open"):
        if any(m.get("to") == aid or m.get("from") == aid for m in d.get("messages", [])):
            out.append(d)
    return out


KNOWN = [
    ("custody.ack", "brain took over 5 s on the gate's test message", "run `mach gate`, fix the slow role, then deploy once"),
    ("agent ingress route did not become ready", "overlapping deploys of the same agent or platform load",
     "wait; deploy that agent once with nothing else in flight for it"),
    ("QUOTA_EXCEEDED", "one update per agent per 5 minutes", "wait for the 300 s countdown (`mach inflight`), then deploy once"),
]


def dep_failure_text(d: dict) -> tuple[str, str]:
    failed = World.dep_failed(d)
    parts = [(str(c.get('detail')) if str(c.get('detail')).startswith(str(c.get('name'))) else f"{c.get('name')}: {c.get('detail')}")
             for c in failed]
    for k in ("error", "detail", "message"):
        if d.get(k) and str(d.get(k)) not in " ".join(parts):
            parts.append(f"{k}: {d.get(k)}")
    stage = failed[0].get("name") if failed else str(d.get("step") or d.get("status"))
    return stage, " | ".join(parts)


def diagnose(w: World, counts: bool = True) -> list[dict]:
    """Redeploy is recommended ONLY for: newest deployment failed with nothing in flight for it, or
    an empty roster role with nothing in flight. Logs alone never justify a redeploy."""
    out = []
    n_flight = sum(1 for aid in w.all_agents() if w.dep_state(w.newest_dep(aid)) == "IN FLIGHT")
    for role in ROLES:
        rk = w.role_key(role)
        r = w.roster.get(rk)
        aid = w.agent_of(role)
        item = {"role": role, "agent_id": aid, "problems": [], "ok": True, "notes": []}
        confirmed = r["confirmed"] if r else None
        dep = w.newest_dep(aid) if aid else None
        st = w.dep_state(dep)
        in_flight_here = st == "IN FLIGHT"
        if not confirmed:
            pen = " (-4 per citizen)" if role in PENALTY_ROLES else ""
            act = "confirm an agent for this role in the console roster"
            if aid and st == "LIVE":
                act += f" (agent {aid.replace('agent:', '')} is already promoted: confirm it, do not redeploy)"
            elif not in_flight_here:
                act += "; deploy one only if nothing is in flight for it"
            else:
                act += "; a deployment is in flight, wait for it"
            item["problems"].append({"code": "EMPTY ROLE", "evidence": f"no confirmed agent in the roster for {role}{pen}",
                                     "action": act})
        if aid:
            con = w.container(aid, counts=counts)
            sv = w.serving(aid, con)
            item["container"] = con
            item["serving"] = sv
            if dep and st == "FAILED":
                stage, text = dep_failure_text(dep)
                hits = [k for k in KNOWN if k[0] in text or (k[0] == "custody.ack" and "renews=[] acks=[]" in text)]
                cause = "; ".join(f"{k[1]} -> {k[2]}" for k in hits) or "unknown cause, read the detail"
                extra = f" ({n_flight} other deployments in flight: wait for the queue first)" if n_flight else ""
                item["problems"].append({"code": "DEPLOY FAILED", "evidence": f"stage {stage}: {trunc(text, 220)}",
                                         "action": cause + extra})
            elif in_flight_here:
                old = World.dep_failed(dep)
                note = f"; carries an older conformance FAIL ({old[0].get('name')}), judge the new run first" if old else ""
                item["problems"].append({"code": "IN FLIGHT", "evidence": f"step {dep.get('step')} status {dep.get('status')} "
                                         f"{trunc(dep.get('detail') or '', 100)}{note}", "action": "do not redeploy this agent; wait"})
            elif st == "LIVE":
                if sv["state"] == "LOGS SAY DOWN":
                    item["problems"].append({"code": "LOGS SAY DOWN", "evidence": sv["why"],
                                             "action": "warning only: watch `mach tail " + role + "` and the next reply; do NOT redeploy from logs alone"})
                if sv["state"] == "UP" and counts and con.get("deliveries") == 0 and sv["replies_15m"] == 0:
                    opn = agent_open_journeys(w, aid)
                    if opn:
                        item["problems"].append({"code": "NO DELIVERIES",
                                                 "evidence": f"0 delivery lines, 0 replies in 15 min, {len(opn)} open journeys on this agent",
                                                 "action": "route problem: check roster visibility; do NOT redeploy"})
                if con.get("say_failed"):
                    codes = sorted(set(re.findall(r"(?:code|status|error|reason)[=: ]+['\"]?([A-Za-z0-9_.-]+)", " ".join(con["say_lines"]))))
                    item["problems"].append({"code": "SAY FAILED",
                                             "evidence": f"{con['say_failed']} care.say.failed lines; codes {codes or 'see logs'}; "
                                             f"last: {trunc(con['say_lines'][-1] if con['say_lines'] else '', 140)}",
                                             "action": "sends are refused: read `mach agent {0} logs --q care.say.failed`".format(role)})
            if con["state"] == "UNKNOWN":
                item["notes"].append("logs empty or rate limited: UNKNOWN, not a fault")
        item["ok"] = not item["problems"]
        out.append(item)
    return out


