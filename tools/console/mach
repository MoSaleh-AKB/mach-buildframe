def log_filter(rows, a):
    out = rows
    if getattr(a, "no_health", False):
        out = [r for r in out if "/health" not in str(r.get("message", ""))]
    if getattr(a, "errors", False):
        out = [r for r in out if str(r.get("level", "")).lower() in ("error", "warning", "warn", "critical")
               or re.search(r"error|failed|traceback|exception", str(r.get("message", "")), re.I)]
    return out


