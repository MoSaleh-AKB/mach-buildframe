        rel = f"+{int((t - t0).total_seconds())}s" if t and t0 else ""
        print(f"{rome(m.get('sent_at'), True)} {rel:>7} {m.get('type', ''):<10} {w.role_name(m.get('from'))} -> {w.role_name(m.get('to'))}")
        print("      " + text_of(m))
    print("\nVERDICT")
    show_obj(d.get("verdict"))
    print("\nRATINGS")
    show_obj(d.get("ratings") or None)
    print("\nLLM REVIEW")
    rv = d.get("review")
    if isinstance(rv, dict):
        for k, v in rv.items():
            print(f"  {w.role_name(k) if str(k).startswith('agent:') else k}: " + (v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)))
    else:
        show_obj(rv)
    if not msgs:
        print("(no messages)")
    elif str(msgs[-1].get("from", "")).startswith("citizen:") and j.get("state") == "open":
        t = parse_t(msgs[-1].get("sent_at"))
        print(f"\nWAITING: last message is the citizen's, {ago((now() - t).total_seconds()) if t else '?'} without reply")


FAMILIES = [
    ("chest pain", re.compile(r"petto|torace|chest|toracic", re.I)),
    ("palpitations", re.compile(r"cuore|batt|palpit|heart|tachicard", re.I)),
    ("back pain", re.compile(r"schiena|lombar|back|colonna|cervic", re.I)),
]


def family_of(text: str) -> str:
    for name, rx in FAMILIES:
        if rx.search(text):
            return name
    return "other"


def cmd_citizens(a):
    w = World()
    groups: dict[str, list[dict]] = {}
    for d in w.details():
        ms = sorted(d.get("messages", []), key=lambda m: str(m.get("sent_at")))
        first = next((m for m in ms if str(m.get("from", "")).startswith("citizen:")), None)
        if not first:
            continue
        txt = text_of(first)
        groups.setdefault(family_of(txt), []).append(
            {"need_id": d["journey"]["need_id"], "citizen": citizen_no(first.get("from")), "state": d["journey"].get("state"),
             "to": first.get("to"), "sent_at": first.get("sent_at"), "text": txt})
    if a.json:
        emit_json(groups)
        return
    tot = sum(len(v) for v in groups.values())
    print(f"CITIZENS {tot} journeys: " + ", ".join(f"{k} {len(v)}" for k, v in groups.items()))
    for name in ["chest pain", "palpitations", "back pain", "other"]:
        v = sorted(groups.get(name, []), key=lambda x: str(x["sent_at"]))
        if not v:
            continue
        print(f"\n== {name.upper()} ({len(v)})")
        for x in v:
            print(f"#{x['citizen']:<4} {rome(x['sent_at'], True)} {x['state']:<7} -> {w.role_name(x['to'])}: {trunc(x['text'], 130)}")


def snapshot(w: World) -> dict:
    s: dict = {"roster": {}, "dep": {}, "container": {}, "journeys": {}, "answered": [], "verdicts": [], "reds": []}
    for role in ROLES:
        r = w.roster.get(w.role_key(role)) or {}
        s["roster"][role] = [r.get("confirmed"), [(x["agent_id"], x.get("visibility")) for x in r.get("agents", [])]]
    for aid in w.all_agents():
        d = w.newest_dep(aid)
        if d:
            fails = World.dep_failed(d)
            s["dep"][w.role_name(aid)] = f"{World.dep_state(d)} {d.get('step')}/{d.get('status')} " + \
                ("; ".join(f"{c.get('name')}: {trunc(c.get('detail'), 80)}" for c in fails) or trunc(d.get("detail") or "", 80))
        s["container"][w.role_name(aid)] = w.serving(aid, w.container(aid, counts=False))["state"]
    for j in w.journeys():
        s["journeys"][j["need_id"]] = j.get("state")
    for d in w.details():
        nid = d["journey"]["need_id"]
        if any(not str(m.get("from", "")).startswith("citizen:") for m in d.get("messages", [])):
            s["answered"].append(nid)
        if d.get("verdict"):
            s["verdicts"].append(nid)
            if re.search(r"\bred\b|red_flag|\"red", json.dumps(d["verdict"], ensure_ascii=False).lower()):
                s["reds"].append(nid)
    return s


def diff_snap(old: dict, new: dict, w: World) -> list[str]:
    out = []
    if old["roster"] != new["roster"]:
        for k in new["roster"]:
            if old["roster"].get(k) != new["roster"][k]:
                out.append(f"roster {k}: {old['roster'].get(k)} -> {new['roster'][k]}")
    for k, v in new["dep"].items():
        if old["dep"].get(k) != v:
            out.append(f"deployment {k}: {old['dep'].get(k, '-')} -> {v}")
    for k, v in new["container"].items():
        if old["container"].get(k) != v:
            out.append(f"container {k}: {old['container'].get(k, '-')} -> {v}")
    for n in new["journeys"]:
        if n not in old["journeys"]:
            out.append(f"new journey {n} ({new['journeys'][n]})")
        elif old["journeys"][n] != new["journeys"][n]:
            out.append(f"journey {n}: {old['journeys'][n]} -> {new['journeys'][n]}")
    for n in new["answered"]:
        if n not in old["answered"]:
            out.append(f"journey {n} now ANSWERED")
    for n in new["verdicts"]:
        if n not in old["verdicts"]:
            out.append(f"new VERDICT on {n}")
    for n in new["reds"]:
        if n not in old["reds"]:
            out.append(f"new RED on {n}")
    return out


def cmd_watch(a):
    old = None
    print(f"watching every {a.every}s; prints only changes (Ctrl-C to stop)")
    while True:
        try:
            for f in CACHE.glob("*.json"):
                f.unlink()
        except OSError:
            pass
        w = World()
        new = snapshot(w)
        stamp = rome(now())
        if old is None:
            print(f"{stamp} baseline: {len(new['journeys'])} journeys, {len(new['answered'])} answered, "
                  f"containers {new['container']}")
        else:
            ch = diff_snap(old, new, w)
            if a.json:
                print(json.dumps({"time": stamp, "changes": ch}, ensure_ascii=False), flush=True)
            else:
                for c in ch:
                    print(f"{stamp} {c}", flush=True)
        old = new
        time.sleep(a.every)


def cmd_tail(a):
    w = World()
    aid = w.agent_of(a.role)
    if not aid:
        print(f"no agent for role {a.role}")
        sys.exit(2)
    seen: set = set()
    first = True
    print(f"tail {a.role} {aid} every {a.every}s (non-health lines, Rome time; Ctrl-C to stop)")
    while True:
        try:
            for f in CACHE.glob("*.json"):
                f.unlink()
        except OSError:
            pass
        try:
            data = fetch(f"/v1/logs?agent_id={quote(aid, safe=':')}&q=", ttl=0)
            rows = sorted(rows_of(data, "lines", "logs", "items"), key=lambda r: str(r.get("time")))
        except FetchError as exc:
            print(f"  [warn] {exc}", file=sys.stderr)
            rows = []
        rows = [r for r in rows if "/health" not in str(r.get("message", ""))]
        new = [r for r in rows if (r.get("time"), r.get("message")) not in seen]
        if first:
            new = new[-10:]
            first = False
        for r in rows:
            seen.add((r.get("time"), r.get("message")))
        print_logs(new)
        sys.stdout.flush()
        time.sleep(a.every)


def cmd_dump(a):
    d = Path(a.dir).expanduser()
    d.mkdir(parents=True, exist_ok=True)
    w = World()
    saved = []

    def save(name, data):
        (d / f"{name}.json").write_text(json.dumps(data, indent=1, ensure_ascii=False))
        saved.append(name)
    for name, path in TABS.items():
        data = get(path, None)
        if data is not None:
            save(name, data)
    for j in w.journeys():
        save("journey_" + j["need_id"], w.detail(j["need_id"]))
    for aid in w.all_agents():
        x = get("/v1/agents/" + quote(aid, safe=""), None)
        if x is not None:
            save("agent_" + aid.replace("agent:", ""), x)
    for c in rows_of(get("/v1/team/conversations", {}), "conversations"):
        x = get("/v1/team/conversations/" + quote(str(c.get("conversation_id")), safe=""), None)
        if x is not None:
            save("conversation_" + re.sub(r"[^A-Za-z0-9_.-]", "_", str(c.get("conversation_id"))), x)
    try:
        feed = fetch("/v1/feed?stream=team", raw=True)
        (d / "feed_team.txt").write_text(str(feed))
        saved.append("feed_team")
    except FetchError as exc:
        print(f"  [warn] feed: {exc}", file=sys.stderr)
    for aid in w.all_agents():
        rows = w.logs(aid)
        if rows is not None:
            save("logs_" + aid.replace("agent:", ""), {"lines": rows})
    if a.json:
        emit_json({"dir": str(d), "files": saved})
    else:
        print(f"DUMP {len(saved)} files in {d}")


def cmd_gate(a):
    py = Path.home() / ".local/share/uv/tools/city-cli/bin/python"
    shared = "asst/_shared/agent.py"
    results: list[tuple[str, bool, str]] = []

    def run(cmd, label):
        try:
            r = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True, timeout=300)
            return r.returncode, (r.stdout or "") + (r.stderr or "")
        except (OSError, subprocess.TimeoutExpired) as exc:
            return 99, str(exc)

    rc, out = run([sys.executable, "-m", "py_compile", shared], "compile")
    results.append(("py_compile asst/_shared/agent.py", rc == 0, out.strip()[-200:]))
    if py.exists():
        rc, out = run([str(py), "-I", "tools/fake-city/conform_time.py", shared], "conform")
        lines = [ln for ln in out.splitlines() if ln.strip()]
        role_lines = [ln for ln in lines if re.match(r"(OK |BAD)\s", ln)]
        for ln in role_lines:
            results.append(("conform_time " + trunc(ln, 90), ln.startswith("OK "), ""))
        if not role_lines or (rc != 0 and all(x[1] for x in results[-len(role_lines):])):
            results.append(("conform_time exit code", rc == 0, trunc(" ".join(lines[-3:]), 200)))
        for script in ("exp2.py", "check_tokens.py"):
            rc, out = run([str(py), "-I", f"tools/fake-city/{script}", shared], script)
            results.append((f"{script} asst/_shared/agent.py", rc == 0, "" if rc == 0 else trunc(" ".join(out.strip().splitlines()[-3:]), 220)))
    else:
        results.append(("city-cli python found", False, str(py) + " missing"))
    base = (REPO / shared).read_bytes() if (REPO / shared).exists() else b""
    for role in ROLES:
        f = REPO / "asst" / role / "agent" / "agent.py"
        same = f.exists() and f.read_bytes() == base
        results.append((f"asst/{role}/agent/agent.py identical to _shared", same, "" if same else "differs or missing"))
    ok = all(r[1] for r in results)
    if a.json:
        emit_json({"ok": ok, "checks": [{"check": c, "pass": p, "detail": d} for c, p, d in results]})
    else:
        for c, p, d in results:
            print(f"{'PASS' if p else 'FAIL'}  {c}" + (f"   {d}" if d and not p else ""))
        print(f"\nGATE {'PASS' if ok else 'FAIL'}: {sum(1 for r in results if r[1])}/{len(results)} checks")
    sys.exit(0 if ok else 1)


def main() -> int:
    ap = argparse.ArgumentParser(prog="mach", description="Read-only CLI for the MACH team console (GET only).")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help_, json_=True):
        p = sub.add_parser(name, help=help_)
        p.add_argument("--json", action="store_true", help="raw JSON output")
        p.set_defaults(fn=fn)
        return p
    p = add("status", cmd_status, "one screen: wave, roster, deployments, containers, journeys, score")
    p.add_argument("--fast", action="store_true", help="skip the per-agent delivery/brain/say-failure log queries")
    p = add("doctor", cmd_doctor, "one plain-words diagnosis per role, with evidence and next action")
    p.add_argument("--fast", action="store_true", help="skip the delivery and say-failure log queries")
    add("roster", cmd_roster, "roles, confirmed agent, brain folder, visibility")
    add("wave", cmd_wave, "wave level, multiplier, rules")
    p = add("deployments", cmd_deployments, "all deployments with failed stage and detail")
    p.add_argument("--agent", metavar="ROLE")
    add("reputation", simple_tab("reputation"), "reputation per agent")
    add("usage", simple_tab("usage"), "LLM calls, tokens, estimated spend")
    add("market", simple_tab("market"), "market offers, wins, ratings")
    add("conversations", simple_tab("conversations"), "conversations tab")
