def cmd_status(a):
    w = World()
    wave = get("/v1/team/wave", {})
    rep = get("/v1/team/reputation", {})
    jl = w.journeys()
    states: dict[str, int] = {}
    for j in jl:
        states[str(j.get("state"))] = states.get(str(j.get("state")), 0) + 1
    rows, res = [], []
    ups = 0
    for role in ROLES:
        rk = w.role_key(role)
        r = w.roster.get(rk) or {}
        aid = w.agent_of(role)
        conf = r.get("confirmed")
        dep = w.newest_dep(aid) if aid else None
        dstate = World.dep_state(dep)
        dtxt = "-"
        if dep:
            fails = World.dep_failed(dep)
            dtxt = f"{dep.get('step')}/{dep.get('status')}"
            if fails:
                dtxt += f" FAIL {fails[0].get('name')}: {trunc(fails[0].get('detail'), 60)}"
            elif dep.get("detail"):
                dtxt += " " + trunc(dep.get("detail"), 60)
        con = w.container(aid, counts=not a.fast) if aid else {"state": "-", "age": None}
        sv = w.serving(aid, con) if aid else {"state": "-", "last_reply": None, "last_reply_age": None, "replies_15m": 0}
        if sv["state"] == "UP":
            ups += 1
        lr = "-" if not sv.get("last_reply") else f"{rome(sv['last_reply'])} ({ago(sv['last_reply_age'])})"
        logs_note = con["state"] + (f" {ago(con['age'])}" if con.get("age") is not None else "")
        row = [role, (aid or "-").replace("agent:", ""), ",".join(w.brains.get(aid or "", [])) or "-",
               ("EMPTY ROLE" if not conf else w.visibility(conf)) + ("" if conf or not aid else f" [{w.visibility(aid)}]"),
               dstate + " " + dtxt, sv["state"], lr, sv.get("replies_15m", 0), logs_note,
               "-" if con.get("deliveries") is None else con["deliveries"],
               "-" if con.get("brain_runs") is None else con["brain_runs"],
               "-" if con.get("say_failed") is None else con["say_failed"]]
        rows.append(row)
        res.append({"role": role, "agent_id": aid, "confirmed": conf, "visibility": w.visibility(conf) if conf else None,
                    "brain": w.brains.get(aid or "", []), "deployment": dep, "deployment_state": dstate, "container": con, "serving": sv})
    if a.json:
        emit_json({"wave": wave, "journeys": states, "score": rep.get("score"), "roles": res})
        return
    empty = [r["role"] for r in res if not r["confirmed"]]
    print(f"STATUS {rome(now(), date=True)} Rome | wave L{wave.get('level')} x{wave.get('multiplier')} {wave.get('state')} | "
          f"{ups}/{len(ROLES)} roles serving | journeys {len(jl)} | score {rep.get('score')}"
          + (f" | EMPTY ROLES: {', '.join(empty)}" if empty else ""))
    print(f"wave rules: {wave.get('active_rules') or 'none'}; notice {wave.get('rule_notice') or '-'}; agenda {rome(wave.get('agenda_now'), True)}")
    print()
    print(table(rows, ["role", "agent", "brain folder", "roster", "newest deployment", "serving", "last reply", "15m", "logs", "deliv", "brain", "say-fail"]))
    print()
    print("journeys: " + ", ".join(f"{k} {v}" for k, v in sorted(states.items())) + f"   score {rep.get('score')}"
          "\nserving: UP = promoted AND (reply in last 10 min OR recent log lines). logs UNKNOWN = empty or rate limited, not a fault."
          "\ndeliv/brain/say-fail count the last 150 log lines per query.")


